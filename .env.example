# Anthropic API Key for Claude LLM Brain
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Specify Claude model
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional: Custom API base URL (for proxy or alternative endpoints)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Examples for different providers:
# OpenRouter: ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
# Custom proxy: ANTHROPIC_BASE_URL=http://localhost:8080/v1

# Java Configuration
# JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
# JAVA_PATHS=java,C:/Program Files/Java/jdk-24/bin/java.exe

# EPUB Check Configuration
# EPUBCHECK_JAR=epubcheck.jar

# OpenAI Agents SDK
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4.1
# OPENAI_TEMPERATURE=0.2
# OPENAI_AGENT_MAX_TURNS=6
# OPENAI_BASE_URL=https://api.openai.com/v1   # or OPENAI_API_BASE
# OPENAI_ORG=org_123
# OPENAI_PROJECT=proj_123
# OPENAI_API_MODE=responses   # or chat_completions

# Debug Configuration
# DEBUG=true
